#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{
    char ch;
    char s[100];
    char sen[100];

    // 1. Read the single character
    scanf("%c", &ch);

    // 2. Read the single word (stops at whitespace/newline)
    scanf("%s", s);

    // 3. Consume the leftover newline character from the previous input,
    //    then read the entire sentence until the next newline.
    scanf("\n");
    scanf("%[^\n]%*c", sen);

    // Print the outputs on separate lines
    printf("%c\n", ch);
    printf("%s\n", s);
    printf("%s\n", sen);

    return 0;
}
